# Copy to .env.local for local development. In Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Auth.js session encryption key. Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth client (Google Cloud → APIs & Services → Credentials → OAuth client ID, type "Web application")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only these Google accounts can sign in (comma-separated)
ALLOWED_EMAILS=michael@luncreative.com

# Service account that edits the tracker Sheet (share the Sheet with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from the service account JSON, including the BEGIN/END lines.
GOOGLE_PRIVATE_KEY=

# The tracker spreadsheet ID (the long part of its URL between /d/ and /edit)
SHEET_ID=1EHbflPj5VuAtAvf7fFbWG_u0m76p7ZFnMVUQyQFxYN8

# Bearer token for POST /api/ingest/activity (the iPhone Shortcut that sends Apple Watch data).
# At least 32 characters. Generate with: openssl rand -base64 33
# Leave empty to switch the endpoint off (it then answers 503 to everything).
INGEST_TOKEN=
